{
  "name": "@chanom/dev-config",
  "version": "0.0.3",
  "description": "Shared oxlint and oxfmt config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peeranat-dan/chanom.git",
    "directory": "packages/dev-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxfmt/config": {
      "development": "./src/oxfmt/index.ts",
      "types": "./dist/oxfmt/index.d.ts",
      "default": "./dist/oxfmt/index.js"
    },
    "./oxfmt/base": {
      "development": "./src/oxfmt/base-config.ts",
      "types": "./dist/oxfmt/base-config.d.ts",
      "default": "./dist/oxfmt/base-config.js"
    },
    "./oxlint/config": {
      "development": "./src/oxlint/index.ts",
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxlint/base": {
      "development": "./src/oxlint/base-config.ts",
      "types": "./dist/oxlint/base-config.d.ts",
      "default": "./dist/oxlint/base-config.js"
    },
    "./oxlint/react": {
      "development": "./src/oxlint/react-config.ts",
      "types": "./dist/oxlint/react-config.d.ts",
      "default": "./dist/oxlint/react-config.js"
    },
    "./oxlint/plugin": {
      "development": "./src/oxlint/plugin/index.ts",
      "types": "./dist/oxlint/plugin/index.d.ts",
      "default": "./dist/oxlint/plugin/index.js"
    },
    "./knip/config": {
      "development": "./src/knip/index.ts",
      "types": "./dist/knip/index.d.ts",
      "default": "./dist/knip/index.js"
    },
    "./knip/base": {
      "development": "./src/knip/base-config.ts",
      "types": "./dist/knip/base-config.d.ts",
      "default": "./dist/knip/base-config.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./oxfmt/config": {
        "types": "./dist/oxfmt/index.d.ts",
        "default": "./dist/oxfmt/index.js"
      },
      "./oxfmt/base": {
        "types": "./dist/oxfmt/base-config.d.ts",
        "default": "./dist/oxfmt/base-config.js"
      },
      "./oxlint/config": {
        "types": "./dist/oxlint/index.d.ts",
        "default": "./dist/oxlint/index.js"
      },
      "./oxlint/base": {
        "types": "./dist/oxlint/base-config.d.ts",
        "default": "./dist/oxlint/base-config.js"
      },
      "./oxlint/react": {
        "types": "./dist/oxlint/react-config.d.ts",
        "default": "./dist/oxlint/react-config.js"
      },
      "./oxlint/plugin": {
        "types": "./dist/oxlint/plugin/index.d.ts",
        "default": "./dist/oxlint/plugin/index.js"
      },
      "./knip/config": {
        "types": "./dist/knip/index.d.ts",
        "default": "./dist/knip/index.js"
      },
      "./knip/base": {
        "types": "./dist/knip/base-config.d.ts",
        "default": "./dist/knip/base-config.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@tsconfig/node-ts": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
